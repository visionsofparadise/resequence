{
	"extends": ["stylelint-config-recommended"],
	"rules": {
		"at-rule-no-unknown": [
			true,
			{
				"ignoreAtRules": ["theme", "utility", "variant", "custom-variant", "source", "plugin", "apply", "reference"]
			}
		],
		"nesting-selector-no-missing-scoping-root": null
	},
	"ignoreFiles": ["**/node_modules/**", "**/dist/**", "**/out/**", "**/build/**", "**/coverage/**", "**/.*/**"]
}
