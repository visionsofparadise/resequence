{
  "name": "resequence",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "author": "Matt Cavender",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visionsofparadise/resequence.git"
  },
  "scripts": {
    "check": "concurrently \"eslint .\" \"tsc --noEmit\"",
    "agent:check": "concurrently \"eslint . --format ../../agent-eslint.js\" \"tsc --noEmit --pretty false 2>&1 | node ../../agent-tsc.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "agent:lint": "eslint . --format ../../agent-eslint.js",
    "build": "tsup src/index.ts --format esm --dts --treeshake --clean",
    "unit": "vitest run unit"
  },
  "devDependencies": {
    "concurrently": "*",
    "tsup": "^8.0.0",
    "typescript": "*",
    "vitest": "^3.0.0"
  }
}
