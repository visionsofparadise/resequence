{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignore": [".githooks/pre-push.mjs"],
	"ignoreDependencies": [
		"prettier",
		"@commitlint/cli",
		"eslint-formatter-unix",
		"textlint-filter-rule-comments",
		"textlint-rule-no-dead-link"
	],
	"workspaces": {
		".": {},
		"apps/*": {
			"project": ["src/**/*.{ts,tsx,css}"]
		},
		"packages/*": {
			"project": ["src/**/*.{ts,tsx}"]
		},
		"apps/studio": {
			"project": ["src/**/*.{ts,tsx,css}"],
			"entry": [
				"src/main/index.ts",
				"src/preload/index.ts",
				"forge.config.ts",
				"vite.main.config.ts",
				"vite.preload.config.ts",
				"vite.renderer.config.ts"
			]
		},
		"apps/design-system-demo": {
			"project": ["src/**/*.{ts,tsx,css}"],
			"ignoreDependencies": ["three", "@react-three/fiber", "@types/three"]
		},
		"packages/patterns-core": {
			"project": ["src/**/*.{ts,tsx}"],
			"ignoreIssues": {
				"src/**": ["duplicates"]
			}
		},
		"packages/web-au": {
			"project": ["src/**/*.{ts,tsx}"],
			"ignoreIssues": {
				"src/**": ["duplicates"]
			}
		}
	}
}
