{
  "name": "resequence",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./patterns": {
      "types": "./dist/patterns.d.ts",
      "import": "./dist/patterns.js"
    },
    "./patterns/core": {
      "types": "./dist/patterns-core.d.ts",
      "import": "./dist/patterns-core.js"
    },
    "./patterns/utils": {
      "types": "./dist/patterns-utils.d.ts",
      "import": "./dist/patterns-utils.js"
    },
    "./web-au": {
      "types": "./dist/web-au.d.ts",
      "import": "./dist/web-au.js"
    },
    "./web-au/core": {
      "types": "./dist/web-au-core.d.ts",
      "import": "./dist/web-au-core.js"
    },
    "./web-au/utils": {
      "types": "./dist/web-au-utils.d.ts",
      "import": "./dist/web-au-utils.js"
    }
  },
  "bin": {
    "resequence": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "author": "Matt Cavender",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visionsofparadise/resequence.git"
  },
  "scripts": {
    "check": "concurrently \"eslint . --fix --cache --format ../../agent-eslint.js\" \"tsc --noEmit --pretty false 2>&1 | node ../../agent-tsc.js\"",
    "check:verbose": "concurrently \"eslint .\" \"tsc --noEmit\"",
    "lint": "eslint . --fix --cache --format ../../agent-eslint.js",
    "lint:verbose": "eslint .",
    "lint:fix": "eslint . --fix",
    "agent:lint": "eslint . --format ../../agent-eslint.js",
    "build": "tsup",
    "unit": "vitest run unit"
  },
  "devDependencies": {
    "concurrently": "*",
    "tsup": "^8.0.0",
    "typescript": "*",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@resequence/patterns": "*",
    "@resequence/patterns-core": "*",
    "@resequence/patterns-utils": "*",
    "@resequence/web-au": "*",
    "@resequence/web-au-core": "*",
    "@resequence/web-au-utils": "*",
    "commander": "^13.1.0",
    "node-web-audio-api": "^1.0.8",
    "tsx": "^4.21.0",
    "wavefile": "^11.0.0"
  }
}
